ORG 0000H

MOV 50H,#06H
MOV 51H,#06H

MOV R0,50H
MOV R1,51H

CLR A
MOV 52H,A

COMPARE:
MOV A,R0
JZ CHECK_R1
MOV A,R1
JZ R0_GREATER
DEC R0
DEC R1
JNZ COMPARE

CHECK_R1:
MOV A,R1
JZ EQUAL
MOV A,#0FFH
MOV 52H,A
SJMP END

R0_GREATER:
MOV A,#01H
MOV 52H,A
SJMP END

EQUAL:
CLR A
MOV 52H,A

END:
SJMP END
END
